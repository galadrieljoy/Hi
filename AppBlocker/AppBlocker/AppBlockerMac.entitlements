<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox MUST be disabled so NSWorkspace can observe and terminate other apps. -->
	<!-- This app cannot be distributed on the Mac App Store in this configuration.   -->
	<!-- It can be notarized and distributed directly (Developer ID signing).         -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
